var card=document.querySelector('.gx-card');
if(card&&!document.getElementById('lb-giochi')){var sec=card.closest('section');if(sec)sec.insertAdjacentHTML('afterend','<section class="sec" style="padding-top:0"><div class="w"><div class="lbx" style="max-width:560px;margin:0 auto">'+shell('<div id="lb-giochi"></div>','<a class="lbx-go" href="/pages/autopostale">Gioca e scala la classifica</a>')+'</div></div></section>')}
var gb=document.getElementById('lb-giochi');if(gb)board(gb,{n:10});
})();
