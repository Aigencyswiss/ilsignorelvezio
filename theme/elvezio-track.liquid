{%- comment -%} Contatore anonimo di Elvezio: visite, video, giochi, iscrizioni. Niente cookie, niente dati personali. {%- endcomment -%}
<script>
(function(){
var E='__ENDPOINT__';
try{var q=location.search;if(/[?&]noi=1/.test(q))localStorage.setItem('elv_noi','1');if(/[?&]noi=0/.test(q))localStorage.removeItem('elv_noi');if(localStorage.getItem('elv_noi')==='1')return;}catch(e){}
if((window.Shopify&&Shopify.designMode)||/preview_theme_id=/.test(location.search))return;
var ss={get:function(k){try{return sessionStorage.getItem(k)}catch(e){return null}},set:function(k,v){try{sessionStorage.setItem(k,v)}catch(e){}}};
var sid=ss.get('elv_sid');if(!sid){sid=Math.random().toString(36).slice(2)+Date.now().toString(36);ss.set('elv_sid',sid)}
var P=new URLSearchParams(location.search),ref='',src=P.get('utm_source'),med=P.get('utm_medium'),camp=P.get('utm_campaign');
try{ref=document.referrer?new URL(document.referrer).hostname:''}catch(e){}
if(ref===location.hostname)ref='';
if(!src&&ref){var M=[[/instagram/,'instagram'],[/facebook|fb\.|fb$/,'facebook'],[/google\./,'google'],[/tiktok/,'tiktok'],[/whatsapp|wa\.me/,'whatsapp'],[/youtube|youtu\.be/,'youtube'],[/bing\./,'bing'],[/linkedin|lnkd/,'linkedin'],[/t\.co$|twitter|x\.com/,'x']];src=ref;for(var i=0;i<M.length;i++){if(M[i][0].test(ref)){src=M[i][1];break}}}
if(src){ss.set('elv_src',src.toLowerCase());if(med)ss.set('elv_med',med);if(camp)ss.set('elv_camp',camp)}
var ua=navigator.userAgent,dev=/iPad|Tablet/i.test(ua)?'tablet':(/Mobi|Android|iPhone/i.test(ua)?'mobile':'desktop');
var ctx={sid:sid,src:ss.get('elv_src'),med:ss.get('elv_med'),camp:ss.get('elv_camp'),ref:ref||null,dev:dev};
var queue=[],timer=null;
function flush(){if(!queue.length)return;var b=JSON.stringify(Object.assign({},ctx,{ev:queue.splice(0,20)}));try{if(navigator.sendBeacon&&navigator.sendBeacon(E,new Blob([b],{type:'text/plain'})))return}catch(e){}try{fetch(E,{method:'POST',body:b,keepalive:true,headers:{'Content-Type':'text/plain'}})}catch(e){}}
function track(t,o){o=o||{};queue.push({t:t,p:location.pathname,n:o.n||null,v:o.v==null?null:o.v,l:o.l||null});clearTimeout(timer);timer=setTimeout(flush,t==='pv'?0:400)}
window.elvTrack=track;
addEventListener('pagehide',flush);document.addEventListener('visibilitychange',function(){if(document.visibilityState==='hidden')flush()});
track('pv');
function vname(v){var a=v.getAttribute('aria-label');if(a)return a;var p=v.closest('[class]');var t=p&&p.parentElement&&p.parentElement.querySelector('p');if(t&&t.textContent.trim())return t.textContent.trim().slice(0,100);return (v.currentSrc||v.src||'video').split('/').pop().slice(0,60)}
function hookVideo(v){if(v.__elv)return;v.__elv=1;var s={};v.addEventListener('play',function(){if(!s.p){s.p=1;track('video_play',{n:vname(v)})}});v.addEventListener('timeupdate',function(){if(!s.h&&v.duration&&v.currentTime/v.duration>=.5){s.h=1;track('video_half',{n:vname(v)})}});v.addEventListener('ended',function(){if(!s.e){s.e=1;track('video_end',{n:vname(v)})}})}
function hookAll(){document.querySelectorAll('video').forEach(hookVideo)}
hookAll();
document.addEventListener('submit',function(e){var f=e.target;if(!f||!f.querySelector)return;var tg=f.querySelector('[name="contact[tags]"]');if(tg){var n=(tg.value||'').split(',').map(function(x){return x.trim()}).filter(function(x){return x&&x!=='newsletter'})[0]||'newsletter';track('signup',{n:n});flush()}},true);
var lv=function(){try{return localStorage.getItem('ap_lvl')||'medio'}catch(e){return null}};
var qEnd=false,aEnd=false;
document.addEventListener('click',function(e){var t=e.target&&e.target.closest?e.target:null;if(!t)return;
 if(t.closest('#ap-go,#ap-again')){aEnd=false;track('game_start',{n:'autopostale',l:lv()})}
 else if(t.closest('#ap-share')){track('share',{n:'autopostale'})}
 else if(t.closest('#elvq #go,#elvq #again')){qEnd=false;track('game_start',{n:'quiz'})}
 else if(t.closest('#elvq #share')){track('share',{n:'quiz'})}
 else{var a=t.closest('a[href^="http"]');if(a&&a.hostname!==location.hostname)track('click',{n:a.hostname.replace(/^www\./,'')})}
},true);
var ov=document.getElementById('ap-over');
if(ov)new MutationObserver(function(){if(!ov.hidden&&!aEnd){aEnd=true;var m=document.getElementById('ap-m');track('game_end',{n:'autopostale',l:lv(),v:m?parseInt(m.textContent,10)||0:null})}}).observe(ov,{attributes:true,attributeFilter:['hidden']});
var qz=document.getElementById('elvq');
if(qz)new MutationObserver(function(){var sc=qz.querySelector('.score');if(sc&&!qEnd){qEnd=true;track('game_end',{n:'quiz',v:parseInt(sc.textContent,10)||0})}else if(!sc){qEnd=false}}).observe(qz,{childList:true,subtree:true});
new MutationObserver(hookAll).observe(document.body,{childList:true,subtree:true});
})();
</script>
